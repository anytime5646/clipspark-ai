# Optional: enables Gemini to rank transcript moments. Keep this secret on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

MAX_UPLOAD_MB=500
FFMPEG_PRESET=veryfast
DATA_DIR=./data
